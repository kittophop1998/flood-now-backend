PORT=4000
DATABASE_URL=postgres://floodnow:floodnow@localhost:5433/floodnow?sslmode=disable
WEB_ORIGIN=http://localhost:3000
# Report lifecycle (see docs/database.md#freshness--lifecycle)
REPORT_STALE_AFTER=2h
REPORT_TTL=6h
FACILITY_REPORT_STALE_AFTER=12h
FACILITY_REPORT_TTL=48h
REPORT_RESOLVE_THRESHOLD=2

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=floodnow-uploads
# Optional: override the derived https://<account>.r2.cloudflarestorage.com endpoint
R2_ENDPOINT=

IMAGEKIT_BASE_URL=https://ik.imagekit.io/your-imagekit-id/floodnow-uploads

# Location search / reverse geocoding (Nominatim-compatible). The public OSM
# instance allows ~1 req/s and requires an identifying User-Agent; use a
# self-hosted or commercial instance for production traffic.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=FloodNow/1.0 (community flood map)

# Safe-route candidate routes (OSRM-compatible HTTP API). FloodNow only scores
# the routes it returns. The public routing.openstreetmap.de instances are for
# light use; point these at a self-hosted OSRM for production traffic.
ROUTER_URL=https://routing.openstreetmap.de/routed-car
ROUTER_FOOT_URL=https://routing.openstreetmap.de/routed-foot

# Operator console / admin API (/api/v1/admin/*): shared bearer token, at
# least 24 characters. Leave empty to disable the admin API entirely.
ADMIN_TOKEN=

# Moderation (see docs/database.md): distinct devices with pending problem
# reports that auto-hide a report, and complaints allowed per device per hour.
MODERATION_AUTO_HIDE_THRESHOLD=3
MODERATION_MAX_PER_DEVICE_HOUR=10

# PromptPay donation QR (optional). The menu only appears when
# DONATION_ENABLED=true AND PROMPTPAY_ID is a valid PromptPay id (10-digit
# mobile number, 13-digit national/tax id, or 15-digit e-wallet id).
# Never commit a real recipient here.
DONATION_ENABLED=false
PROMPTPAY_ID=
PROMPTPAY_NAME=
