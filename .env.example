PORT=4000
DATABASE_URL=postgres://floodnow:floodnow@localhost:5433/floodnow?sslmode=disable
# production (the default when unset): Secure session cookie, HTTPS only,
# https WEB_ORIGIN required — unsafe values stop the boot. Use development
# only for local http://localhost.
APP_ENV=development
# Exact web-app origin(s), comma-separated, no wildcard. The only origins
# allowed CORS with credentials and signed-in writes / sign-in.
WEB_ORIGIN=http://localhost:3000

# Session cookie (HttpOnly, Path=/, host-only). Defaults: production
# __Host-floodnow_session + Secure; development floodnow_session, not Secure.
# SameSite=strict needs the API on a host same-site with the web app
# (e.g. api.<web domain>); none (cross-site) must be Secure and is blocked
# by Safari — avoid it.
SESSION_COOKIE_NAME=
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=strict
# IPs/CIDRs of the TLS-terminating proxy whose X-Forwarded-For/-Proto are
# believed (client IP for rate limits, https check). Empty = private and
# loopback networks (where a platform edge such as Railway's connects
# from); "none" = trust nobody.
TRUSTED_PROXIES=
# Report lifecycle (see docs/database.md#freshness--lifecycle)
REPORT_STALE_AFTER=2h
REPORT_TTL=6h
# Long-lived categories (shelter, aid point, road damage, construction)
FACILITY_REPORT_STALE_AFTER=12h
FACILITY_REPORT_TTL=48h
REPORT_RESOLVE_THRESHOLD=2

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=floodnow-uploads
# Optional: override the derived https://<account>.r2.cloudflarestorage.com endpoint
R2_ENDPOINT=

IMAGEKIT_BASE_URL=https://ik.imagekit.io/your-imagekit-id/floodnow-uploads

# Location search / reverse geocoding (Nominatim-compatible). The public OSM
# instance allows ~1 req/s and requires an identifying User-Agent; use a
# self-hosted or commercial instance for production traffic.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=FloodNow/1.0 (community flood map)

# Safe-route candidate routes (OSRM-compatible HTTP API). FloodNow only scores
# the routes it returns. The public routing.openstreetmap.de instances are for
# light use; point these at a self-hosted OSRM for production traffic.
ROUTER_URL=https://routing.openstreetmap.de/routed-car
ROUTER_FOOT_URL=https://routing.openstreetmap.de/routed-foot

# Operator console / admin API (/api/v1/admin/*): shared bearer token, at
# least 24 characters. Leave empty to disable the admin API entirely.
ADMIN_TOKEN=

# Moderation (see docs/database.md): distinct devices with pending problem
# reports that auto-hide a report, and complaints allowed per device per hour.
MODERATION_AUTO_HIDE_THRESHOLD=3
MODERATION_MAX_PER_DEVICE_HOUR=10

# PromptPay donation QR (optional). The menu only appears when
# DONATION_ENABLED=true AND PROMPTPAY_ID is a valid PromptPay id (10-digit
# mobile number, 13-digit national/tax id, or 15-digit e-wallet id).
# Never commit a real recipient here.
DONATION_ENABLED=false
PROMPTPAY_ID=
PROMPTPAY_NAME=

# Official GISTDA flood-area map layer (optional). Off unless
# GISTDA_ENABLED=true AND both GISTDA_BASE_URL and GISTDA_API_KEY are set;
# anything missing/invalid disables only this layer. The key stays on the
# server (sent as GISTDA's "API-Key" header) and never reaches the browser.
# Official base URL: https://api-gateway.gistda.or.th/api/2.0/resources
GISTDA_ENABLED=false
GISTDA_BASE_URL=
GISTDA_API_KEY=
GISTDA_CACHE_TTL_MINUTES=15

# Official DOH highway camera layer (optional, no key). Off unless
# DOH_CCTV_ENABLED=true. The API reads camera locations from the public
# Highway Traffic map page (https://highwaytraffic.go.th/DOHWeb/Home.aspx) at
# most once per DOH_CCTV_CACHE_TTL_MINUTES (5–1440, default 60); users open
# the pictures on DOH's own page. A bad base URL disables only this layer.
DOH_CCTV_ENABLED=false
DOH_CCTV_BASE_URL=https://highwaytraffic.go.th
DOH_CCTV_CACHE_TTL_MINUTES=60

# Scheduled R2 image cleanup (see docs/database.md#image-cleanup). Deletes
# only unreferenced uploads (past the orphan grace period) and images
# belonging to resolved/expired reports or ended announcements (past the
# retention period) — never an image an active entity still uses. Any
# invalid value here falls back to its default instead of failing to boot.
R2_CLEANUP_ENABLED=true
R2_CLEANUP_CRON="0 3 * * *"
R2_ORPHAN_RETENTION_HOURS=24
R2_RESOLVED_IMAGE_RETENTION_DAYS=7
R2_CLEANUP_BATCH_SIZE=100
# Dry-run: log what would be deleted without deleting anything. Recommended
# before first enabling this in production.
R2_CLEANUP_DRY_RUN=false


