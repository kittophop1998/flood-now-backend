PORT=4000
DATABASE_URL=postgres://floodnow:floodnow@localhost:5433/floodnow?sslmode=disable
WEB_ORIGIN=http://localhost:3000
# Report lifecycle (see docs/database.md#freshness--lifecycle)
REPORT_STALE_AFTER=2h
REPORT_TTL=6h
FACILITY_REPORT_STALE_AFTER=12h
FACILITY_REPORT_TTL=48h
REPORT_RESOLVE_THRESHOLD=2

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=floodnow-uploads
# Optional: override the derived https://<account>.r2.cloudflarestorage.com endpoint
R2_ENDPOINT=

IMAGEKIT_BASE_URL=https://ik.imagekit.io/your-imagekit-id/floodnow-uploads

# Location search / reverse geocoding (Nominatim-compatible). The public OSM
# instance allows ~1 req/s and requires an identifying User-Agent; use a
# self-hosted or commercial instance for production traffic.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=FloodNow/1.0 (community flood map)
